DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&schema=public"
NODE_ENV="development"
PORT="3000"
REQUEST_BODY_LIMIT="50mb"

# Comma-separated list of allowed frontend origins.
# Example: "https://your-frontend.com,https://www.your-frontend.com"
CLIENT_URLS="http://localhost:8080,http://localhost:3000"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Optional. Used by GET /api/public/gitHubStats.
GITHUB_USERNAME="Mabeny-dev"
GITHUB_TOKEN=""
GITHUB_STATS_CACHE_MINUTES="5"

# Newsletter welcome email SMTP settings.
# johnmabeny.com currently uses Zoho Mail.
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="info@johnmabeny.com"
SMTP_PASS="replace-with-the-mailbox-password-or-app-password"
MAIL_FROM_NAME="John Mabeny"
MAIL_FROM_EMAIL="info@johnmabeny.com"
MAIL_REPLY_TO="info@johnmabeny.com"
WEBSITE_URL="https://www.johnmabeny.com"
